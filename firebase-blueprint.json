{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User project snapshot storing turns, chapters, artifacts, and edges",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "turns": { "type": "array" },
        "chapters": { "type": "array" },
        "artifacts": { "type": "array" },
        "edges": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["projectId", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user account information"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Stores complete project state, dialogue timeline, chapters, artifacts, and edges"
    }
  }
}
