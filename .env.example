# ─────────────────────────────────────────────────────────────────────
# Env layering (env files cannot import each other — we load them in order):
#   real OS/runtime env  >  .env (this file — personal, gitignored,
#                           one per workspace)  >  .env.shared (local,
#                           gitignored)
#
# RULE: env files NEVER enter git. Only this .example template is tracked,
# and it holds placeholders only.
#
# Only put values you need to OVERRIDE per workspace here — often just:
#   PORT=3093
# Non-secret defaults can live in .env.shared (also gitignored).
# ─────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Client Auth & Project Variables (loaded via environment, not hardcoded files)
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
GOOGLE_OAUTH_CLIENT_ID=""

# GOOGLE_PICKER_API_KEY: Google Cloud "API key" credential used by the
# Google Picker file dialog in the Import modal (Drive & Docs import).
# Create at: APIs & Services → Credentials → Create credentials → API key.
# Enable the "Google Drive API" for the project, and restrict the key by
# HTTP referrer to your deployed origin (+ http://localhost:* for dev).
# NOTE: referrer restrictions are known to break Picker (its iframe runs on
# docs.google.com) — leave the key unrestricted while testing.
GOOGLE_PICKER_API_KEY=""

# VITE_GOOGLE_PICKER_ENABLED: feature flag for the "Browse Google Drive…"
# Picker button in the Import modal. Shelved by default (unfinished —
# developer-key issues on localhost; paste-a-link import works).
# Set to "true" and restart the dev server to re-enable.
VITE_GOOGLE_PICKER_ENABLED="false"
