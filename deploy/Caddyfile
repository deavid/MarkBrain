# Site config for MarkBrain, rendered by deploy/ansible/playbook.yml from
# markbrain_domain and markbrain_port in your Ansible inventory — the domain
# and port below are filled in at deploy time; don't edit them here.
{{ markbrain_domain }} {
    encode zstd gzip

    # Only /api/* wakes up the Node + SQLite daemon on 127.0.0.1:{{ markbrain_port }}.
    # flush_interval -1 ensures SSE chat streams (/api/jobs/*/stream) never buffer.
    handle /api/* {
        reverse_proxy 127.0.0.1:{{ markbrain_port }} {
            flush_interval -1
        }
    }

    # All static assets and SPA routes are served directly by Caddy from disk.
    # Random visitors in Local Workspace mode never touch the Node process.
    handle {
        root * /srv/markbrain/dist
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
