[markbrain_vps]
markbrain.unhaunter.com ansible_user=root

[markbrain_vps:vars]
markbrain_domain=markbrain.unhaunter.com
markbrain_port=3032
markbrain_owner_email=you@example.com
# Pass initial owner password only on first bootstrap via:
# ansible-playbook -i deploy/ansible/inventory.ini deploy/ansible/playbook.yml -e "markbrain_owner_password=..."
# The playbook writes it to /etc/markbrain/secrets/owner-password (0600) on the
# VPS only for the duration of the run and deletes it right after — the hash
# file is the only persistent artifact. Later deploys need nothing passed.
# Rotate with: -e "markbrain_owner_password=<new> rotate_owner_password=true"
markbrain_owner_password=""
# SSH connection multiplexing — speeds up repeated deploys noticeably
ansible_ssh_common_args="-o ControlMaster=auto -o ControlPersist=60s"
